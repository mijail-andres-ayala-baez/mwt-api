# Copy this file to .env and replace the sample values. Never commit the real .env.
# Only needed to run the API with npm (npm run start:dev).
# With "docker compose up -d" the API takes its settings from docker-compose.yml.

# Database started with Docker (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mwt_dev

# Database installed on your computer (replace your_password)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mwt_dev

# Port the API listens on (default 3000). Use 4000 if the web already uses 3000
PORT=4000

# Front-end addresses allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Amazon RDS and Cognito: not used for now (we work locally with Docker)
# DATABASE_URL=postgresql://your_user:your_password@your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/mwt_dev
# DATABASE_SSL_CA=certs/global-bundle.pem
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=your_app_client_id
